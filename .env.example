# Copy to .env and fill in real values. Never commit .env.

APP_ENV=production
APP_TIMEZONE=Asia/Shanghai

# SQLite database URL. Relative paths are resolved against the working directory.
DATABASE_URL=sqlite:///./data/training.db

# Required in production. Generate with: openssl rand -hex 32
SECRET_KEY=

# Path to the Product Hub registry (YAML). Production uses instance/products.yaml.
PRODUCTS_CONFIG_PATH=instance/products.yaml

# Path to the training plan YAML.
TRAINING_PLAN_PATH=app/data/training_plan.yaml

# Set true only when serving over HTTPS.
SESSION_SECURE=true
